# Copy to .env for local development. Never commit .env.
# Generate the two keys with:  npm run gen-keys

NODE_ENV=development
PORT=8787

# Public origin the browser uses. Used for CSRF Origin checks and links in emails.
APP_ORIGIN=http://localhost:8787

# Local development database (started with `npm run dev:db`, data kept in .dev-db/).
# Choose your own local password; it is only used by the embedded dev server.
DATABASE_URL=postgres://traced:change-me-local-only@127.0.0.1:54329/traced

# 32-byte keys, base64. Different value per environment. Losing DATA_ENCRYPTION_KEY
# makes encrypted columns (MFA secrets) unreadable.
TOKEN_HMAC_KEY=
DATA_ENCRYPTION_KEY=

# false only for plain-http localhost. Production must be true (HTTPS).
COOKIE_SECURE=false

# Number of reverse proxies in front of the API (client IP = that many entries from the RIGHT of
# X-Forwarded-For; client-written entries are never trusted). 0 = local, direct connections.
# Production must set this explicitly: Cloud Run direct = 1, Vercel rewrite -> Cloud Run = 2.
# See docs/architecture.md "Client IP and trusted proxies". (Legacy TRUST_PROXY=true means 1.)
TRUSTED_PROXY_HOPS=0
# Optional chain validation: only read X-Forwarded-For when the socket peer is in these CIDRs.
# TRUSTED_PROXY_CIDRS=
# Optional: secret the outermost proxy sends as x-traced-proxy-auth (Secret Manager in production).
# TRUSTED_PROXY_SECRET=

# dev    = write emails to MAIL_DEV_DIR (HTML previews with the QR embedded) and print links. Nothing is sent.
# resend = send through Resend (needs an approved account, a verified sending domain and an API key).
#          Production refuses anything but resend. Do not put a real key in this file.
MAIL_TRANSPORT=dev
MAIL_DEV_DIR=.dev-mail
# MAIL_FROM=TRACED <no-reply@your-verified-domain.sa>
# MAIL_REPLY_TO=support@your-verified-domain.sa
# RESEND_API_KEY=
# How often the email outbox retries due emails (ms).
OUTBOX_INTERVAL_MS=15000

# Local development only: lets the staff portal simulate identity-verification outcomes
# (the server refuses to start with this in production).
DEV_IDENTITY_VERIFICATION=true

# Database connections per server instance.
DB_POOL_MAX=5

# Secret for scheduled outbox runs (production: Cloud Scheduler; store in Secret Manager).
# INTERNAL_CRON_SECRET=

# Serve the static site from dist/ on the same origin as the API (local development only).
SERVE_STATIC=true
