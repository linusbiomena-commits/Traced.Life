# TRACED API container for Cloud Run. TEMPLATE ONLY (Phase 7): not built or deployed anywhere.
# Copy to the repository root as `Dockerfile` in Phase 8, after approval. The static site keeps
# being served by Vercel; this image serves /api/v1 only (SERVE_STATIC must be false).
#
#   docker build -t traced-api .
#   docker run --rm -p 8080:8080 --env-file prod.env traced-api   # never commit prod.env

FROM node:22.20-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# Full install (tsx runs the TypeScript sources at runtime), then drop test-only packages.
RUN npm ci --ignore-scripts \
 && npm prune --omit=dev --ignore-scripts \
 && npm install --no-save --ignore-scripts tsx@4.23.15

FROM node:22.20-bookworm-slim
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    SERVE_STATIC=false
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY server/src ./server/src
COPY server/migrations ./server/migrations
COPY server/sql ./server/sql
# Run as the unprivileged "node" user; the filesystem is read-only on Cloud Run anyway.
USER node
EXPOSE 8080
# Migrations are NOT run here: they run as a separate Cloud Run job with the owner role
# (see docs/deploy/phase-8-plan.md). The service connects as traced_app.
CMD ["node", "--import", "tsx", "server/src/index.ts"]
