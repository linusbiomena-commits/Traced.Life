# Copy to .env for local development. Never commit .env.
# Generate the two keys with:  npm run gen-keys

NODE_ENV=development
PORT=8787

# Public origin the browser uses. Used for CSRF Origin checks and links in emails.
APP_ORIGIN=http://localhost:8787

# Local development database (started with `npm run dev:db`, data kept in .dev-db/).
# Choose your own local password; it is only used by the embedded dev server.
DATABASE_URL=postgres://traced:change-me-local-only@127.0.0.1:54329/traced

# 32-byte keys, base64. Different value per environment. Losing DATA_ENCRYPTION_KEY
# makes encrypted columns (MFA secrets) unreadable.
TOKEN_HMAC_KEY=
DATA_ENCRYPTION_KEY=

# false only for plain-http localhost. Production must be true (HTTPS).
COOKIE_SECURE=false

# true only behind a proxy that sets X-Forwarded-For (e.g. Vercel).
TRUST_PROXY=false

# dev = write emails to MAIL_DEV_DIR and print them to the console. No real email is sent.
MAIL_TRANSPORT=dev
MAIL_DEV_DIR=.dev-mail

# Serve the static site from dist/ on the same origin as the API (local development only).
SERVE_STATIC=true
